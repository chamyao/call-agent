# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low keeps replies fast on the phone; raise to medium if it makes poor calls
CLAUDE_EFFORT=low

# Twilio (console.twilio.com -> Account Info)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# A Twilio number you own, E.164 format
TWILIO_FROM_NUMBER=+15551234567

# Public HTTPS URL that reaches this server: your frp domain (see "Running it
# through your own server" in the README), or an ngrok URL for quick tests
PUBLIC_URL=https://calls.yourdomain.com

# frp tunnel to your VPS (used by deploy/mac/install.sh)
FRP_SERVER_ADDR=203.0.113.10
# Same long random string you pass to deploy/vps/setup.sh
FRP_TOKEN=change-me

# Any long random string; the `call` command uses it to talk to the server.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALL_AGENT_TOKEN=change-me

# Who the agent says it's calling for
OWNER_NAME=Your Name
# Optional: how text-to-speech should spell your name to say it right (e.g. Chamm Yao)
# OWNER_NAME_SPOKEN=
# Your cell. Enables "transfer to me" when a rep needs the account holder.
# Leave empty to disable transfers.
OWNER_PHONE=+15559876543
# Text you the summary after each call (needs a number that can send SMS)
SMS_SUMMARY=false

# Optional
# PROFILE_PATH=profile.md
# CALLS_DIR=calls
# MAX_CALL_SECONDS=5400

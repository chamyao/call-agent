# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low keeps replies fast on the phone; raise to medium if it makes poor calls
CLAUDE_EFFORT=low

# Twilio (console.twilio.com -> Account Info)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# A Twilio number you own, E.164 format
TWILIO_FROM_NUMBER=+15551234567

# Public HTTPS URL that reaches this server (e.g. from `ngrok http 8000`)
PUBLIC_URL=https://your-subdomain.ngrok.app

# Any long random string; the `call` command uses it to talk to the server.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALL_AGENT_TOKEN=change-me

# Who the agent says it's calling for
OWNER_NAME=Your Name
# Your cell. Enables "transfer to me" when a rep needs the account holder.
# Leave empty to disable transfers.
OWNER_PHONE=+15559876543
# Text you the summary after each call (needs a number that can send SMS)
SMS_SUMMARY=false

# Optional
# PROFILE_PATH=profile.md
# CALLS_DIR=calls
# MAX_CALL_SECONDS=5400
